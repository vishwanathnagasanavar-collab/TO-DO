{
  "appId": "com.taskflow.smarttodo",
  "productName": "TaskFlow",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "server.ts",
    "server/**/*",
    "src/types.ts",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
